# Web Analytics is already enabled in Vercel. Set false to disable measurement.
NEXT_PUBLIC_WEB_ANALYTICS=true

# Custom contact events require a supported Vercel plan (Pro or Enterprise).
# Keep false unless that feature is already available for the project.
NEXT_PUBLIC_CONTACT_ANALYTICS=false

# Optional: HTML verification token for a Search Console URL-prefix property.
# A domain property instead uses the DNS verification record issued by Google.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
